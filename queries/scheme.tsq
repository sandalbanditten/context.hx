;; vi:ft=tsq

;; Lambda Context
(
  list
    .
    (symbol) @_kw
    (#any-of? @_kw "lambda" "λ")
    .
    (list) @context.name
    .
    _
) @context

;; Constants
(
  list
    .
    (symbol) @_kw
    (#eq? @_kw "define")
    .
    (symbol) @context.name
    .
    _
) @context

;; Functions
(
  list
    .
    (symbol) @_kw
    (#eq? @_kw "define")
    .
    (list
      .
      (symbol) @context.name
      .
      (symbol)*
    )
    .
    _
) @context
