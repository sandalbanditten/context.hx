;; vi:ft=tsq

;; Lambda Context
(
  list
    .
    (symbol) @keyword
    (#any-of? @keyword "lambda" "λ")
    .
    (list)
    .
    _
) @context

;; Constants
(
  list
    .
    (symbol) @keyword
    (#any-of? @keyword "define" "define-syntax" "define-macro")
    .
    (symbol) @name
) @context

;; Functions
(
  list
    .
    (symbol) @keyword
    (#any-of? @keyword "define" "define/contract")
    .
    (list
      .
      (symbol) @function
      .
      (symbol)*
    )
) @context
