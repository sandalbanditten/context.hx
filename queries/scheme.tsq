;; vi:ft=tsq

;; Lambda Context
(
  list
    .
    (symbol) @context.name
    (#any-of? @context.name "lambda" "λ" "let" "let*")
    .
    (list)
    .
    (_)
) @context

;; Constants
(
  list
    .
    (symbol) @_kw
    (#eq? @_kw "define")
    .
    (symbol) @context.name
    .
    (_)
) @context

;; Functions
(
  list
    .
    (symbol) @_kw
    (#eq? @_kw "define")
    .
    (list
      .
      (symbol) @context.name
      .
      (symbol)*
    )
    .
    (_)
) @context
