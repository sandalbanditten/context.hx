;; vi:ft=tsq

(mod_item
  ((visibility_modifier _) @keyword)?
  "mod" @keyword
  name: (identifier) @namespace
) @context

(impl_item
  "impl" @keyword
  type: (_) @type
  !trait
) @context

;; with trait
(impl_item
  "impl" @keyword
  trait: (_) @type
  "for" @keyword
  type: (_) @type
) @context

(struct_item
  ((visibility_modifier _) @keyword)?
  "struct" @keyword
  name: (_) @type
) @context


(enum_item
  ((visibility_modifier _) @keyword)?
  "enum" @keyword
  name: (_) @type
) @context

(function_item
  ((visibility_modifier _) @keyword)?
  "fn" @keyword.function
  name: _ @function
) @context
